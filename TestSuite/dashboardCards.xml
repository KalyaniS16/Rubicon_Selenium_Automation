<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Dashboard Cards Test" parallel="false" thread-count="1">

    <listeners>
        <listener class-name="org.rubicon.listeners.TestListener"/>
    </listeners>

    <test name="Verify Dashboard Cards Count functionality">
        <classes>
            <class name="org.rubicon.tests.DashboardPageTest"/>
            <class name="org.rubicon.tests.ScheduledProjectsCardTest"/>
            <class name="org.rubicon.tests.ActiveProjectsCardTest"/>
            <class name="org.rubicon.tests.InactiveProjectsCardTest"/>
            <class name="org.rubicon.tests.ScheduledEmployeesCardTest"/>
            <class name="org.rubicon.tests.ActiveEmployeesCardTest"/>
            <class name="org.rubicon.tests.ProductionReportsCardTest"/>
        </classes>
    </test>

</suite>